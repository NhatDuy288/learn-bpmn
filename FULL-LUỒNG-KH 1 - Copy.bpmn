    <bpmn:textAnnotation id="TextAnnotation_1b65nai">
      <bpmn:text>1/Tạo mới
2/Đã tồn tại thì không tạo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_068223n">
      <bpmn:text>blacklist  rồi gọi highrisk</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0hl6dqo">
      <bpmn:text>Kiểm tra 13 -&gt; chưa done thì ngưng luôn /  co kết quả 13 thì 15 mới chạy 
Nếu xong 13+ có cif -&gt; kiểm tra cif ở Core -&gt; khớp thì đi tiếp ko thì ngưng
nếu ko tạo dc cif -&gt; lms kiểm tra = số gttt + trạng thái / hợp lệ thì lấy lên đi tiếp / ko hợp lệ thì ra quầy cập nhật/ ko có cif thì tạo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_10hylen">
      <bpmn:text>liab hợp lệ
tổng liab
nợ quá hạn
co cif rồi thì check thẻ (nếu có thẻ vikki/hd rồi thi ko cho tạo thẻ muadee)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0f0t4mb">
      <bpmn:text>sau khi check xong các đk bên, Nếu có y/c debit thì tạo debit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1g9k9d0">
      <bpmn:text>Theo rule check tồn tại liability trên hệ thống</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0yh8qjr">
      <bpmn:text>- Liability thỏa điều kiện
- Policy 
- Branch code thẻ
- Mã KPI
- Hạn mức</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1k98r8d">
      <bpmn:text>1/Dropoff
2/New</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0s62aax">
      <bpmn:text>Có sản phẩm classic thông báo và dừng hành trình
Chưa có: đi tiếp hành trình</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qud6px">
      <bpmn:text>cif, user ebanking, tktt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12osx7h">
      <bpmn:text>Gọi API tạo thẻ ảo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1uilwln">
      <bpmn:text>Kết hợp kết quả RE, share liability ở W4 và kết quả tạo thẻ LMS</bpmn:text>
    </bpmn:textAnnotation>
