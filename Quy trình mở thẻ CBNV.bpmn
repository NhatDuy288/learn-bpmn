    <bpmn:textAnnotation id="TextAnnotation_008t3qg">
      <bpmn:text>Chưa có hồ sơ đăng ký thì đi tiếp hành trình
Hồ sơ đăng ký tồn tại + chưa có thẻ hoặc đã có thẻ thì thông báo rồi dừng hành trình</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1w5qxup">
      <bpmn:text>Nếu TK trích nợ không tồn tại thì khong cho đi tiếp hành trình</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06cw154">
      <bpmn:text>Nếu không tồn tại tài khoản trích nợ thì cho không cho tiếp tục hành trình</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ads8bn">
      <bpmn:text>Check:
- Trùng device
- Trùng sdt tham chiếu
- Số lượng hồ sơ đang xử lí
- Hồ sơ bị từ chối</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0loy05n">
      <bpmn:text>Liab hợp lệ
Tổng liab
Dư nợ quá hạn</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_168zj5o">
      <bpmn:text>Theo rule check tồn tại liability trên hệ thống</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r2quza">
      <bpmn:text>- Liability thỏa điều kiện
- Policy 
- Hạn mức</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12osx7h">
      <bpmn:text>Gọi API tạo thẻ ảo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0u8n8r7">
      <bpmn:text>Kết quả RE + share liab W4 + kết quả tạo thẻ LMS</bpmn:text>
    </bpmn:textAnnotation>
