    <bpmn:textAnnotation id="TextAnnotation_1i2zxrw">
      <bpmn:text>TH POS không nhận được response và bị TIMEOUT thì phải check lại trạng thái giao dịch ở HTTT, nếu không xác định được trạng thái thì KH phải yêu cầu NV hỗ trợ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_02cj2ta" associationDirection="None" sourceRef="Activity_0zlj7ep" targetRef="TextAnnotation_1i2zxrw" />
