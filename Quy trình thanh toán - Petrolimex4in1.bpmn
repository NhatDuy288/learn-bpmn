    <bpmn:textAnnotation id="TextAnnotation_1jv67r0">
      <bpmn:text>Trạng thái giao dịch thành công, ID khách hàng để tích điểm nếu có</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1360qff">
      <bpmn:text>Check xem thông tin giao dịch có ID khách hàng không, có thì mới tích điểm</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0epuozt" associationDirection="None" sourceRef="Activity_01vot3a" targetRef="TextAnnotation_1jv67r0" />
